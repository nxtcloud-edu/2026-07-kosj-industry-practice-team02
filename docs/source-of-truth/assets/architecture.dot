
digraph G {
  graph [rankdir=LR, bgcolor="transparent", pad="0.25", nodesep="0.35", ranksep="0.65", fontname="Noto Sans CJK KR"];
  node [shape=box, style="rounded,filled", fontname="Noto Sans CJK KR", fontsize=13, color="#d7e0ec", penwidth=1.5, margin="0.20,0.14"];
  edge [fontname="Noto Sans CJK KR", fontsize=11, color="#8491a3", penwidth=1.6, arrowsize=0.8];
  user [label="시민 /chat", fillcolor="#eaf2ff", fontcolor="#155ec7"];
  api [label="FastAPI 질문 처리", fillcolor="#ffffff"];
  mask [label="개인정보 탐지·마스킹\n(외부 LLM 호출 전)", fillcolor="#fff7e8", fontcolor="#9b5200"];
  cls [label="민원 의도·모호성 분류", fillcolor="#ffffff"];
  search [label="공식 ACTIVE KB 검색\n키워드+메타데이터 / 임베딩 보조", fillcolor="#ffffff"];
  decision [label="근거 충족?", shape=diamond, fillcolor="#f1f4f8"];
  answer [label="구조화 답변\n서버가 출처 메타데이터 결합", fillcolor="#eafaf2", fontcolor="#137747"];
  fallback [label="안전 폴백\n4개 사유+다음 행동", fillcolor="#fff0ef", fontcolor="#a5443a"];
  event [label="비식별 이벤트 저장\n성공: 메타데이터만\n실패: masked_question 추가", fillcolor="#f5f1ff", fontcolor="#6b46b8"];
  admin [label="관리자 /admin\n실패 질문→후보→승인", fillcolor="#eaf2ff", fontcolor="#155ec7"];
  active [label="승인된 ACTIVE KB", fillcolor="#eafaf2", fontcolor="#137747"];
  user -> api -> mask -> cls -> search -> decision;
  decision -> answer [label="예"];
  decision -> fallback [label="아니오"];
  answer -> event;
  fallback -> event;
  event -> admin;
  admin -> active [label="승인"];
  active -> search [label="재질의 개선"];
}
