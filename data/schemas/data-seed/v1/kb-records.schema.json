{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DATA-SEED initial release KB records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "release_version", "records"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "release_version": {"type": "string", "const": "0.1.0-initial.1"},
    "records": {
      "type": "array",
      "minItems": 19,
      "maxItems": 19,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id", "data_origin", "category", "service_name", "question_examples",
          "answer_summary", "procedure_steps", "required_documents", "processing_time",
          "fee", "department", "provider", "source_title", "source_url",
          "source_service_id", "last_verified_at", "caution", "status", "created_by",
          "approved_by", "approved_at"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^KB-(?:MOVE|CERT|WASTE|TAX)-[0-9]{2}$"},
          "data_origin": {"type": "string", "const": "OFFICIAL"},
          "category": {"enum": ["MOVE_IN_RESIDENT_REGISTRATION", "CERTIFICATE_ISSUANCE", "BULKY_WASTE", "LOCAL_TAX_GENERAL"]},
          "service_name": {"type": "string", "minLength": 1},
          "question_examples": {"type": "array", "minItems": 3, "maxItems": 5, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
          "answer_summary": {"type": "string", "minLength": 1},
          "procedure_steps": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "required_documents": {"type": "array", "items": {"type": "string", "minLength": 1}},
          "processing_time": {"type": ["string", "null"]},
          "fee": {"type": ["string", "null"]},
          "department": {"type": "string", "minLength": 1},
          "provider": {"type": "string", "minLength": 1},
          "source_title": {"type": "string", "minLength": 1},
          "source_url": {"type": "string", "format": "https-url"},
          "source_service_id": {"type": ["string", "null"]},
          "last_verified_at": {"type": "string", "format": "date"},
          "caution": {"type": ["string", "null"]},
          "status": {"type": "string", "const": "ACTIVE"},
          "created_by": {"type": "string", "const": "AI-DATA-BACKEND"},
          "approved_by": {"type": "string", "const": "PM-LOCAL-001"},
          "approved_at": {"type": "string", "format": "date-time"}
        }
      }
    }
  }
}
