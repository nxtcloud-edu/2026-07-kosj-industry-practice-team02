{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DATA-SEED successor immutable release manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "release_id",
    "release_version",
    "source_draft_version",
    "released_at",
    "approval",
    "artifacts",
    "projection",
    "seed_semantic_sha256",
    "excluded_record_ids",
    "generator",
    "correction"
  ],
  "properties": {
    "schema_version": {"type": "integer", "const": 2},
    "release_id": {"type": "string", "const": "sejong-official-0.1.0-initial.2"},
    "release_version": {"type": "string", "const": "0.1.0-initial.2"},
    "source_draft_version": {"type": "string", "const": "0.1.0-draft.1"},
    "released_at": {"type": "string", "format": "date-time"},
    "approval": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "reviewed_by", "reviewed_at"],
      "properties": {
        "path": {"type": "string", "const": "approval_manifest.json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
        "reviewed_by": {"type": "string", "const": "PM-LOCAL-001"},
        "reviewed_at": {"type": "string", "format": "date-time"}
      }
    },
    "artifacts": {
      "type": "array",
      "minItems": 5,
      "maxItems": 5,
      "uniqueItems": true,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path", "record_count", "sha256"],
        "properties": {
          "path": {"enum": ["kb_records.json", "offices.json", "office_service_mappings.json", "seed.sql", "compensation.sql"]},
          "record_count": {"type": "integer", "minimum": 0},
          "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
        }
      }
    },
    "projection": {
      "type": "object",
      "additionalProperties": false,
      "required": ["kb", "office", "mapping", "withheld_kb", "rejected_mapping", "mock"],
      "properties": {
        "kb": {"type": "integer", "const": 19},
        "office": {"type": "integer", "const": 3},
        "mapping": {"type": "integer", "const": 10},
        "withheld_kb": {"type": "integer", "const": 1},
        "rejected_mapping": {"type": "integer", "const": 2},
        "mock": {"type": "integer", "const": 0}
      }
    },
    "seed_semantic_sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "excluded_record_ids": {
      "type": "array",
      "minItems": 3,
      "maxItems": 3,
      "uniqueItems": true,
      "items": {
        "enum": [
          "KB-WASTE-03",
          "OFFICE-AREUM:LOCAL_TAX_GENERAL",
          "OFFICE-DODAM:BULKY_WASTE"
        ]
      }
    },
    "generator": {"type": "string", "const": "data-seed-release-v2"},
    "correction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["predecessor_release_version", "predecessor_manifest_sha256", "decision_id", "reason"],
      "properties": {
        "predecessor_release_version": {"const": "0.1.0-initial.1"},
        "predecessor_manifest_sha256": {"const": "e8863a633d28125ad2c0f0323d60467236d08618e767833fc7c09444f1a6e4a2"},
        "decision_id": {"const": "D-044"},
        "reason": {"const": "POSTGRES17_EFFECTIVE_MEMBERSHIP_OPTION_UNION"}
      }
    }
  }
}
