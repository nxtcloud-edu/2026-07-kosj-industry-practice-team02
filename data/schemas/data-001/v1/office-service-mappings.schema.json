{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "DATA-001 office service mapping staging records",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "draft_version", "records"],
  "properties": {
    "schema_version": {"const": 1},
    "draft_version": {"type": "string", "pattern": "^0\\.1\\.0-draft\\.1$"},
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["office_public_id", "intent", "department_label", "evidence_source_url", "last_verified_at", "created_by"],
        "properties": {
          "office_public_id": {"type": "string", "pattern": "^OFFICE-(?:AREUM|DODAM|JOCHIWON)$"},
          "intent": {"enum": ["MOVE_IN_RESIDENT_REGISTRATION", "CERTIFICATE_ISSUANCE", "BULKY_WASTE", "LOCAL_TAX_GENERAL"]},
          "department_label": {"type": ["string", "null"]},
          "evidence_source_url": {"type": "string", "format": "https-url"},
          "last_verified_at": {"type": "string", "format": "date"},
          "created_by": {"const": "AI-DATA-BACKEND"}
        }
      }
    }
  }
}
