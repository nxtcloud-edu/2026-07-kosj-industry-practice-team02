{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "KBRecord",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "category",
    "service_name",
    "question_examples",
    "answer_summary",
    "department",
    "source_title",
    "source_url",
    "last_verified_at",
    "status",
    "created_by"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "category": {
      "enum": [
        "MOVE_IN_RESIDENT_REGISTRATION",
        "CERTIFICATE_ISSUANCE",
        "BULKY_WASTE",
        "LOCAL_TAX_GENERAL"
      ]
    },
    "service_name": {
      "type": "string"
    },
    "question_examples": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string"
      }
    },
    "answer_summary": {
      "type": "string"
    },
    "procedure_steps": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "required_documents": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "processing_time": {
      "type": [
        "string",
        "null"
      ]
    },
    "fee": {
      "type": [
        "string",
        "null"
      ]
    },
    "department": {
      "type": "string"
    },
    "source_title": {
      "type": "string"
    },
    "source_url": {
      "type": "string",
      "format": "uri",
      "pattern": "^https://"
    },
    "last_verified_at": {
      "type": "string",
      "format": "date"
    },
    "caution": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "DRAFT",
        "PENDING",
        "ACTIVE",
        "REJECTED",
        "RETIRED"
      ]
    },
    "created_by": {
      "type": "string"
    },
    "approved_by": {
      "type": [
        "string",
        "null"
      ]
    },
    "approved_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    }
  }
}
