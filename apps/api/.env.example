# Local API process
APP_ENV=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://127.0.0.1:3000

# Database and Supabase values stay blank until the approved local DB slice.
DATABASE_URL=
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Provider is disabled by default and limited to approved synthetic evaluation.
LLM_PROVIDER=disabled
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_ENABLED=false
LLM_RUN_ATTEMPT_CAP=30
DEEPSEEK_ENABLED=false
DEEPSEEK_SYNTHETIC_EVALUATION_MODE=false

# Signed client-carried context
CONTEXT_TOKEN_SECRET=
CONTEXT_TOKEN_TTL_SECONDS=900

# Privacy and local demonstration defaults
PII_RETENTION_DAYS=30
DEMO_OPERATOR_ID=operator-demo
DEMO_APPROVER_ID=approver-demo
ENABLE_EMBEDDINGS=false
ENABLE_DEMO_ROLE_SWITCH=true
ENABLE_LOAD_TEST_ENDPOINT=false
