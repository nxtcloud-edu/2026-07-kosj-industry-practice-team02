# App
APP_ENV=development
APP_VERSION=0.0.0
LOG_LEVEL=INFO
PUBLIC_APP_URL=http://localhost:3000
API_BASE_URL=http://localhost:8000
CORS_ORIGINS=http://localhost:3000

# Database / Supabase
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sejong_ai
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Backend only. Never expose with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# LLM provider adapter — disabled by default; local/private synthetic fixtures only
LLM_PROVIDER=disabled
LLM_MODEL=deepseek-v4-flash
LLM_API_KEY=
LLM_BASE_URL=
LLM_TIMEOUT_SECONDS=15
LLM_MAX_RETRIES=1
LLM_MAX_CONCURRENCY=1
LLM_MAX_OUTPUT_TOKENS=1024
LLM_THINKING_ENABLED=false
LLM_RUN_ATTEMPT_CAP=30
DEEPSEEK_ENABLED=false
DEEPSEEK_SYNTHETIC_EVALUATION_MODE=false

# Signed client-carried context. Supply at runtime; never commit a real value.
CONTEXT_TOKEN_SECRET=
CONTEXT_TOKEN_TTL_SECONDS=900

# Privacy / retention
PII_RETENTION_DAYS=30
STORE_SUCCESS_TEXT=false
STORE_OUT_OF_SCOPE_TEXT=false

# Demo admin roles
DEMO_OPERATOR_ID=operator-demo
DEMO_APPROVER_ID=approver-demo

# Feature flags
ENABLE_EMBEDDINGS=false
ENABLE_DEMO_ROLE_SWITCH=true
ENABLE_LOAD_TEST_ENDPOINT=false
